class RuntimeError {

    constructor(code, message, metadata = {}) {

        this.version =
            "7.4";

        this.code =
            code;

        this.message =
            message;

        this.metadata = {

            timestamp:
                new Date().toISOString(),

            runtimeVersion:
                "7.4",

            ...metadata

        };

    }



    toJSON() {

        return {

            version:
                this.version,

            code:
                this.code,

            message:
                this.message,

            metadata:
                this.metadata

        };

    }

}

export default RuntimeError;