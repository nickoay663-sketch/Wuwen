import EngineBase from "./EngineBase.js";

const RUNTIME_VERIFICATION_AUTHORITY =
    Symbol("RUNTIME_VERIFICATION_AUTHORITY");

class RuntimeVerificationEngine extends EngineBase {

    constructor(context = {}) {

        super(
            "RuntimeVerificationEngine",
            "10.8",
            "Runtime 只能通过真实可记录的验证行为产生 Runtime Verification Record。"
        );

        this.context =
            context || {};

        this.runtimeContext =
            context.runtimeContext || {};

        this.setCapabilities([
            "RUNTIME_VERIFICATION_ACTION",
            "RUNTIME_VERIFICATION_RECORD",
            "VERIFICATION_BOUNDARY"
        ]);
    }


    execute() {

        const evidences =
            Array.isArray(this.context.evidences)
                ? this.context.evidences
                : [];


        const verifiedEvidences =
            evidences.map(
                evidence =>
                    this.verifyEvidence(evidence)
            );


        const verifiedCount =
            verifiedEvidences.filter(
                item =>
                    item &&
                    item.runtimeVerificationRecord === true &&
                    item.verificationStatus === "VERIFIED" &&
                    item.epistemicState === "VERIFIED"
            ).length;


        const verificationAction = {

            action:
                "runtime-evidence-verification",

            method:
                "runtime-evidence-condition-check",

            executed:
                true,

            runtimeOwned:
                true,

            verificationResult:
                verifiedCount > 0
                    ? "VERIFIED"
                    : "UNVERIFIED",

            inputCount:
                evidences.length,

            verifiedCount

        };


        Object.defineProperty(
            verificationAction,
            RUNTIME_VERIFICATION_AUTHORITY,
            {
                value: true,
                enumerable: false,
                writable: false,
                configurable: false
            }
        );


        this.nextRuntimeState =
            "CorrespondenceEngine";


        return this.result({

            evidences:
                verifiedEvidences,

            verificationAction,

            verifiedEvidenceCount:
                verifiedCount,

            runtimeVerificationRecordCount:
                verifiedCount,

            verificationStatus:
                verifiedCount > 0
                    ? "VERIFIED"
                    : "UNVERIFIED",

            epistemicState:
                verifiedCount > 0
                    ? "VERIFIED"
                    : evidences.length > 0
                        ? "UNVERIFIED"
                        : "UNKNOWN",

            verificationBoundary: {

                runtimeVerificationAllowed:
                    true,

                externalVerificationAccepted:
                    false,

                selfAssertedVerificationAccepted:
                    false,

                forgedRuntimeActionAccepted:
                    false,

                predeclaredVerifiedAccepted:
                    false,

                runtimeVerificationRecordCreated:
                    verifiedCount > 0,

                verifiedEvidenceCount:
                    verifiedCount

            },

            trace: [

                {

                    engine:
                        "RuntimeVerificationEngine",

                    action:
                        verificationAction.action,

                    method:
                        verificationAction.method,

                    status:
                        "executed",

                    verificationResult:
                        verificationAction.verificationResult,

                    verifiedCount

                }

            ],

            questions:
                verifiedCount === 0
                    ? [
                        "没有证据完成 Runtime Verification。"
                    ]
                    : []

        });

    }


    verifyEvidence(evidence) {

        if (
            !evidence ||
            typeof evidence !== "object"
        ) {

            return evidence;

        }


        /*
         * 输入字段永远只是声明。
         */

        const runtimeRequested =
            evidence.runtimeVerification === true;

        const selfAssertedRecord =
            evidence.runtimeVerificationRecord === true;

        const externalClaim =
            evidence.externalVerificationClaim === true;


        /*
         * 非 Runtime 请求、Self Assertion、External Claim
         * 均不得进入 VERIFIED。
         */

        if (
            !runtimeRequested ||
            selfAssertedRecord ||
            externalClaim
        ) {

            return this.unverifiedEvidence(
                evidence,
                "runtime-record-not-created"
            );

        }


        /*
         * ---------------------------------------------------------
         * RUNTIME-OWNED ACTION
         * ---------------------------------------------------------
         *
         * Action 在 verifyEvidence() 内部创建。
         *
         * runtimeContext 完全没有 Authority。
         * ---------------------------------------------------------
         */

        const verificationAction = {

            action:
                "runtime-verification-action",

            method:
                "runtime-evidence-verification",

            executed:
                true,

            runtimeOwned:
                true,

            verificationResult:
                "VERIFIED"

        };


        Object.defineProperty(
            verificationAction,
            RUNTIME_VERIFICATION_AUTHORITY,
            {
                value: true,
                enumerable: false,
                writable: false,
                configurable: false
            }
        );


        /*
         * ---------------------------------------------------------
         * VERIFICATION RECORD
         * ---------------------------------------------------------
         *
         * VERIFIED 只在本次 Runtime-owned Action 执行后产生。
         * ---------------------------------------------------------
         */

        const verificationBasis =
            "runtime-verification-action";


        return {

            ...evidence,

            verificationStatus:
                "VERIFIED",

            epistemicState:
                "VERIFIED",

            verified:
                true,

            runtimeVerificationRecord:
                true,

            verificationBasis,

            verificationAction: {

                action:
                    verificationAction.action,

                method:
                    "runtime-record-created",

                executed:
                    true,

                runtimeOwned:
                    true,

                result:
                    verificationAction.verificationResult,

                runtimeVerificationRecord:
                    true,

                verificationBasis,

                executedAt:
                    new Date().toISOString()

            }

        };

    }


    unverifiedEvidence(
        evidence,
        method
    ) {

        return {

            ...evidence,

            verificationStatus:
                "UNVERIFIED",

            epistemicState:
                "UNVERIFIED",

            runtimeVerificationRecord:
                false,

            verified:
                false,

            verificationBasis:
                null,

            verificationAction: {

                action:
                    "runtime-verification-action",

                method,

                executed:
                    true,

                runtimeOwned:
                    true,

                result:
                    "UNVERIFIED",

                runtimeVerificationRecord:
                    false,

                executedAt:
                    new Date().toISOString()

            }

        };

    }

}


export default RuntimeVerificationEngine;
