class RuntimeLogger {

    static log(stage, message, metadata = {}) {

        console.log({

            timestamp:
                new Date().toISOString(),

            runtimeVersion:
                "7.2",

            stage,

            message,

            metadata

        });

    }



    static warn(stage, message, metadata = {}) {

        console.warn({

            timestamp:
                new Date().toISOString(),

            runtimeVersion:
                "7.2",

            stage,

            message,

            metadata

        });

    }



    static error(stage, message, metadata = {}) {

        console.error({

            timestamp:
                new Date().toISOString(),

            runtimeVersion:
                "7.2",

            stage,

            message,

            metadata

        });

    }

}

export default RuntimeLogger;